# Lumen harness — repository root ignore rules.
#
# `harness/.gitignore` already covers the deep cases (test residue, .venv, .build,
# backend/.data) and is deliberately unanchored so it matches at every depth. This file
# only adds the workspace-level trees and the two reference artefacts that must never be
# committed.

# Generated trees: marketing renders, packaged builds, screenshots. 10G and rebuildable.
/outputs/

# Scratch space. `harness/.gitignore` covers the same names inside harness/; these cover
# the workspace root.
.tmp/
.pytest_cache/

# Python environments and bytecode
.venv/
venv/
__pycache__/
*.py[cod]

# Swift build products
.build/
DerivedData/

# OS and tool noise
.DS_Store
*.genie
.workbuddy/

# Reference artefacts that stay on disk but out of git:
#  - the EDNeT shard is 163M, over every host's per-file limit, and is data rather than
#    source;
#  - `ai-learning-software` is a full clone with its own history, so committing it would
#    record a gitlink that clones back as an empty directory.
reference/prior-models/ednet_real/*.parquet
reference/prior-app/ai-learning-software/

# Private workspace state and one-off artefacts that must not be published.
# .workbuddy-ai/ holds agent memory and project notes; the zip is a full source
# snapshot whose contents have not been audited; tts-samples/ is generated audio.
/.workbuddy-ai/
/luminest-source-2026-11-01.zip
/tts-samples/

# A separate WorkBuddy mini-program scaffold, not part of the Luminfest harness.
# Its node_modules is generated regardless, so ignore both.
/luminest-miniprogram/
node_modules/

# relay coordination channel: local state, never shared
/.relay/

# Scratch left in the working directory by local concurrency and tool-access test runs.
# These are databases and temporary directories, not source; without these lines a
# `git add -A` would publish someone's local test state.
/.relay-test/
/.relay-test-*/
/harness/backend/.tool-access-tests.*/
/relay/

# A separate experimental rebuild with its own Git root. Committing it would record a
# gitlink that clones back as an empty directory, so it is deliberately not part of
# this repository's history.
/luminest-v2/
