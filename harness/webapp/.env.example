# Copy to `.env` (or `.env.local`) and adjust.
#
# Base origin for the Luminest backend. The client appends `/v1`, so this should be the
# origin (or a path ending in `/api`). In `npm run dev` this is optional — Vite proxies
# `/api` to the local backend at :8766 (see vite.config.ts). For a built/deployed bundle,
# set this to your real backend origin.
#
# Examples:
#   VITE_API_BASE=http://localhost:8766
#   VITE_API_BASE=https://api.luminest.example
VITE_API_BASE=
