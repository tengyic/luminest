# Copy to a real env file / export before starting. Never commit real tokens.
PORT=8788
LUMINEST_SITE_DIR=/absolute/path/to/closed-beta-site
LUMINEST_BETA_DB=/absolute/path/to/beta.db
LUMINEST_BETA_ADMIN_TOKEN=replace-with-a-long-random-string
# Optional: proxy /api/v1 to the FastAPI product backend so the web client works
LUMINEST_BACKEND_URL=http://127.0.0.1:8766
# Optional: mirror issued share codes into the backend's beta_invites table.
# Set HARNESS_REQUIRE_INVITE=1 on the backend so it enforces the same codes.
LUMINEST_BACKEND_DB=/absolute/path/to/harness.sqlite3
