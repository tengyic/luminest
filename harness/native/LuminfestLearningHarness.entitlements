<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandbox entitlements for a Mac App Store build.

	     The app bundles its own learning server and starts it on 127.0.0.1, so the
	     sandbox needs BOTH directions of local networking: server (to bind the port) and
	     client (to talk to it). The learner's data lives in the app's own container.

	     This file is only used when packaging with --sandbox. A Developer ID build for
	     direct download is not sandboxed, because the store is the only thing that
	     requires it, and sandboxing changes where the bundled server may write. -->

	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- Bind the bundled server to localhost. -->
	<key>com.apple.security.network.server</key>
	<true/>

	<!-- Talk to the bundled server, and (only if an operator configures it) to a
	     remote tutor or a hosted backend. -->
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- Read/write the learner's own database and workspace files, which live inside the
	     sandbox container. No user-selected file access is requested. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>

	<!-- Presentation recording, used only when the learner explicitly starts it. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
</dict>
</plist>
