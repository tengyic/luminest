# Copy to `deploy/.env` and fill in. `docker compose` reads `.env` from the directory of
# the compose file, so this only works when invoked as
#   docker compose -f deploy/compose.yaml up -d          (from harness/)
#   cd deploy && docker compose up -d                     (simplest)
# `deploy/.env` is gitignored by `harness/.gitignore` (`.env`, unanchored). Never commit it.
#
# Every variable marked REQUIRED is enforced at interpolation time by `${VAR:?}` in
# `compose.yaml`, so a missing one stops the command with a message naming the variable
# instead of letting a container crash after PostgreSQL is already running.

# ---------------------------------------------------------------------------------------
# REQUIRED — database and application secret
# ---------------------------------------------------------------------------------------

# PostgreSQL superuser password for the bundled `postgres` service.
HARNESS_POSTGRES_PASSWORD=

# Application secret: signing material for sessions and receipts. `config.py` rejects
# anything shorter than 32 characters or with fewer than 12 distinct characters in
# production. Generate one; do not reuse it across deployments.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
HARNESS_SECRET=

# Comma-separated Host headers this instance will answer for. A wildcard is refused in
# production. Include the public hostname and, if you curl it locally, localhost.
#   HARNESS_ALLOWED_HOSTS=learn.example.org,localhost,127.0.0.1
HARNESS_ALLOWED_HOSTS=

# ---------------------------------------------------------------------------------------
# REQUIRED — the language model. There is no offline mode: `offline` is rejected at boot.
# ---------------------------------------------------------------------------------------

# `openai` (any OpenAI-compatible endpoint) or `ollama`.
HARNESS_TUTOR_PROVIDER=

# Full base URL of the API root, including the version segment where the provider has one.
#   hosted:  https://api.openai.com/v1      (production requires HTTPS for any remote host)
#   ollama:  http://ollama:11434            (the `ollama` hostname is exempt from the HTTPS
#                                            rule because it is the compose network's own
#                                            loopback model runtime)
HARNESS_TUTOR_URL=

# Model id as the provider spells it. There is no default; the boot check refuses to start
# without it because a wrong model fails on the learner's first turn instead of at deploy.
HARNESS_TUTOR_MODEL=

# API key. Leave empty for a local ollama. Required in practice for any remote provider —
# the boot check does not read it (a deployment may inject it another way), so a missing
# key shows up as a 401 on the first tutor turn.
HARNESS_TUTOR_KEY=

# ---------------------------------------------------------------------------------------
# OPTIONAL — defaults are safe to omit
# ---------------------------------------------------------------------------------------

# Host port the API is published on. Bound to 127.0.0.1; put a TLS terminator in front.
#HARNESS_PORT=8000

# Which proxy's X-Forwarded-* headers uvicorn trusts. Set this to your reverse proxy's
# address or the rate limiting will see every request as coming from the proxy.
#HARNESS_TRUSTED_PROXY_IPS=127.0.0.1

# Tutor request ceiling in seconds, 0 < n <= 300. Default 12.
#HARNESS_TUTOR_TIMEOUT_SECONDS=12
